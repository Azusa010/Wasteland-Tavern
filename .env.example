# GEMINI_API_KEY: AI Studio 默认环境自动注入密钥
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: 应用托管地址
APP_URL="MY_APP_URL"

# 多后端推理网关适配配置（支持 gemini / modelscope / opencode / custom）
# 上传魔搭创空间参赛时，设为 modelscope（或留空，当未配 GEMINI_API_KEY 且存在魔搭 Token 时服务端会自动切换至 modelscope）
LLM_PROVIDER="gemini"

# 魔搭社区 ModelScope 创空间配置（创空间后台「设置 -> 环境变量/密钥」填入 MODELSCOPE_API_KEY 或使用平台内置 MODELSCOPE_SDK_TOKEN）
MODELSCOPE_API_KEY=""
MODELSCOPE_SDK_TOKEN=""
DASHSCOPE_API_KEY=""
MODELSCOPE_BASE_URL="https://api-inference.modelscope.cn/v1"
MODELSCOPE_MODEL="Qwen/Qwen2.5-72B-Instruct"

# OpenCode 兼容接口配置
OPENCODE_API_KEY=""
OPENCODE_BASE_URL="https://opencode.ai/zen/go/v1"
OPENCODE_MODEL="hy4-flash-free"

# 自定义 OpenAI 兼容 LLM 接口配置
CUSTOM_LLM_API_KEY=""
CUSTOM_LLM_BASE_URL="https://api.openai.com/v1"
CUSTOM_LLM_MODEL="gpt-4o-mini"

# 自定义 OpenAI 兼容 TTS 语音接口配置
CUSTOM_TTS_API_KEY=""
CUSTOM_TTS_BASE_URL="https://api.openai.com/v1"
CUSTOM_TTS_MODEL="tts-1"

# 自定义图片生成 API 密钥配置
IMAGE_API_KEY=""
IMAGE_BASE_URL=""
IMAGE_MODEL=""
